# Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# File upload limits
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Paths (relative to project root or absolute)
# Vision: YOLO26n instance segmentation (Phase 1)
YOLO_MODEL_PATH=models/yolo26n-seg.pt
# YOLO_MODEL_PATH=models/yolo26n-seg.onnx
UPLOAD_DIR=data/uploads
FEEDBACK_DIR=data/feedback
PSEUDO_LABEL_DIR=data/pseudo_labels

# ---------- LLM (prompt → JSON) ----------
# 전략: docs/plan/AI_MODEL_STRATEGY.md
# 로컬 기본: Ollama Gemma 4 E4B
# 고도화: openai | gemini
LLM_PROVIDER=ollama
# ollama | openai | gemini | heuristic

# Ollama (local, free, offline)
LLM_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# OpenAI-compatible base (optional):
# LLM_BASE_URL=http://localhost:11434/v1

# OpenAI (upgrade path — quality)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (upgrade path — free tier / cost)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Redis (Phase 2)
REDIS_URL=redis://localhost:6379/0

# File retention (hours)
FILE_RETENTION_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# ---------- Database ----------
# Local default: SQLite file. Production/docker: mariadb.
# DB_DIALECT=sqlite | mariadb
DB_DIALECT=sqlite
SQLITE_PATH=data/cutnkeep.db
# Optional full URL override (wins over DB_DIALECT helpers)
# DATABASE_URL=sqlite:///D:/my_project/CutNKeep/data/cutnkeep.db
# DATABASE_URL=mysql+pymysql://cutnkeep:cutnkeep@localhost:3306/cutnkeep?charset=utf8mb4

# MariaDB (when DB_DIALECT=mariadb)
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=cutnkeep
MARIADB_PASSWORD=cutnkeep
MARIADB_DATABASE=cutnkeep
DB_ECHO=false

# Frontend / Console (Vite)
VITE_API_BASE_URL=http://localhost:8000
# console dev: http://localhost:5174
# frontend dev: http://localhost:5173
