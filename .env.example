# =============================================================================
# 【수동】 이 파일을 복사해 `.env` 로 쓰고 값을 채운다 (`.env` 는 git 무시)
# 코드의 Settings(backend/app/core/config.py) 가 아래 키를 읽는다.
#
# Docker: docker compose -p cut_and_keep --env-file .env up -d --build
#   backend 컨테이너는 docker-compose.yml 이 DB/Redis/LLM 접속 주소를 덮어씀
#   호스트 DBeaver: 127.0.0.1 + MARIADB_PORT + MARIADB_USER/PASSWORD
#   Adminer: http://localhost:8081  Server=mariadb
# =============================================================================

# Backend
APP_ENV=development
DEBUG=true
# 【수동·보안】 배포 시 반드시 교체 (비밀번호 재설정 코드 HMAC 키 — 바꾸면 발급된 코드 무효)
SECRET_KEY=change-me-in-production
# APP_ENV=production 에서 위험한 설정이면 기동 거부 (backend/app/core/preflight.py, 확인: python -m app.core.preflight)
PREFLIGHT_STRICT=true

# ---------- 계정 (로그인 · 회원가입 · 아이디/비밀번호 찾기) ----------
# 상세: docs/guidance/auth.md
SESSION_COOKIE_NAME=cnk_session
SESSION_TTL_HOURS=168
# 【수동·배포】 HTTPS 배포에서는 true (로컬 http 에서 true 면 쿠키가 저장되지 않음)
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_SECONDS=60

# 메일 (아이디 찾기 · 재설정 코드). SMTP_HOST 가 비면 발송 대신 서버 로그에만 기록 (개발용)
# 【수동·배포 필수】 배포에서는 반드시 SMTP 설정
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cut & Keep <no-reply@cutnkeep.local>
SMTP_STARTTLS=true

# 【수동·보안】 운영 콘솔 API(/api/v1/console/*) 접근
#   CONSOLE_ADMINS        : 관리자 아이디(쉼표 구분). 사용자 앱에서 가입한 계정 — 이 계정으로 로그인하면 어디서든 콘솔 사용
#   CONSOLE_REQUIRE_LOGIN : true 면 서버 PC(loopback)도 로그인 필수. 같은 서버의 nginx 등을 거치면 요청이 127.0.0.1 로
#                           보여 콘솔이 열릴 수 있으므로 배포에서는 true
#   CONSOLE_ALLOW_REMOTE  : true 면 누구나 (하위 호환 — 관리자 로그인을 쓰면 false 유지)
CONSOLE_ADMINS=
CONSOLE_REQUIRE_LOGIN=false
CONSOLE_ALLOW_REMOTE=false
# 이 대역에서 온 요청의 X-Real-IP 를 실제 IP 로 (비로그인 속도 제한). 호스트 단독 실행은 비움, Docker 는 compose 가 172.16.0.0/12
TRUSTED_PROXIES=
# Docker 의 backend·MariaDB·Redis·Adminer 포트를 열 주소. 기본 127.0.0.1(이 PC만) — 다른 기기에서 직접 열 때만 0.0.0.0
# BIND_HOST=127.0.0.1

# 업로드(LLM + GPU) 분당 허용 횟수 — 비로그인은 IP, 회원은 계정 기준. 0 = 제한 없음
UPLOAD_RATE_GUEST_PER_MIN=6
UPLOAD_RATE_MEMBER_PER_MIN=20

# File upload limits — 프론트 ImageUploader maxSize 와 동기
MAX_UPLOAD_SIZE_MB=20
# 압축 폭탄 방지: 사진 해상도 상한(픽셀 수). 파일이 작아도 풀면 수 GB 인 이미지를 디코딩 전에 거부
MAX_IMAGE_PIXELS=40000000
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ---------- Paths ----------
# 서비스 런타임 (backend/ 기준 상대 또는 절대)
# 【수동·필수】 서빙할 세그 가중치를 backend/models/ 에 배치 (training/yolo/apply_best.py)
#   파일 없으면 stub 마스크. detect 전용 .pt 넣지 말 것 (masks 필요)
YOLO_MODEL_PATH=models/yolo26m-seg.pt
# YOLO_MODEL_PATH=models/yolo26m-seg.onnx   # torch 없이 onnxruntime 으로 (docs/plan/ONNX_INFERENCE.md)
# SEG_PREFER_ONNX=true   # .onnx 일 때 ultralytics 가 설치돼 있어도 onnxruntime 사용
# SEG_RUNTIME=onnx       # Docker 빌드 인자 — torch·ultralytics 를 이미지에 넣지 않음 (1.11 GB)
UPLOAD_DIR=data/uploads
LOG_DIR=logs
LOG_RETENTION_DAYS=14
# 기동 직후 세그 모델을 백그라운드로 미리 로드 (첫 요청 지연 제거). 테스트·저사양에서는 false
PRELOAD_MODELS=true

# 학습 공유 (저장소 루트 기준) — backend 가 기록, training/scripts 가 읽음
FEEDBACK_DIR=data/feedback
PSEUDO_LABEL_DIR=data/pseudo_labels

# ---------- LLM (prompt → JSON) ----------
# 전략: docs/plan/AI_MODEL_STRATEGY.md
# 호출: backend/app/services/prompt_llm.py (nodes.prompt_analyzer 에서 분기)
#   LLM_PROVIDER 에 따라 Ollama/OpenAI/Gemini → 실패·타임아웃 시 휴리스틱 fallback
LLM_PROVIDER=ollama
# ollama | openai | gemini | lora | heuristic
# 기본 provider 가 실패하면 LLM_FALLBACK 을 한 번 더 시도한 뒤 휴리스틱
# (같은 이름·heuristic·빈 값이면 건너뜀)
LLM_FALLBACK=ollama
# 초과 시 다음 provider 또는 휴리스틱 (Ollama 첫 호출은 모델 로드로 느릴 수 있음)
LLM_TIMEOUT_SECONDS=30

# Ollama (local) — ollama pull gemma4:e4b 선행
# 호스트 실행 시 localhost. Docker backend 는 compose 가 host.docker.internal 사용
LLM_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# (선택) Docker 전용 덮어쓰기. 비우면 compose 기본 host.docker.internal:11434
# DOCKER_LLM_BASE_URL=http://host.docker.internal:11434

# 프롬프트 RAG — 운영 콘솔에서 승인된 교정·좋아요·회원 요청 중 비슷한 문장을 LLM 예시로 붙임 (ollama/openai/gemini)
# 상세·평가: docs/guidance/llm-and-vision.md. seed·pseudo_label 추가는 평가에서 정확도를 낮춰 비권장
PROMPT_RAG_ENABLED=true
PROMPT_RAG_SOURCES=correction,like,request
PROMPT_RAG_TOP_K=3
PROMPT_RAG_MIN_SCORE=0.6
PROMPT_RAG_REFRESH_SECONDS=30

# LoRA (LLM_PROVIDER=lora) — training/lora 로 학습한 어댑터 서빙 (backend/ 기준 경로)
#   transformers·peft 필요 (requirements.txt 선택 줄). 어댑터는 backend/models/lora/ 에 복사
# LORA_BASE_MODEL=../training/models/qwen2.5-1.5b-instruct
# LORA_ADAPTER_PATH=models/lora

# OpenAI / Gemini (고도화) — 키는 비워 두고 필요할 때만 채움
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- Redis ----------
# 호스트 → compose Redis (호스트 포트 6380 → 컨테이너 6379)
REDIS_URL=redis://localhost:6380/0
# Docker backend: compose 가 redis://redis:6379/0 으로 덮어씀
# true + backend·celery_worker 둘 다 같은 값이어야 한다: BATCH_USE_CELERY=true docker compose -p cut_and_keep --env-file .env --profile phase2 up -d backend celery_worker
BATCH_USE_CELERY=false

FILE_RETENTION_HOURS=24
# 백엔드가 직접 보관 기간 지난 업로드를 지우는 주기(분). 0 = 끔 (scripts/cleanup.py 를 따로 돌릴 때)
FILE_CLEANUP_MINUTES=60
# 서비스 DB(SQLite) 자동 백업 주기(시간)와 보관 개수 → backend/data/backups/. 0 = 끔
DB_BACKUP_HOURS=24
DB_BACKUP_KEEP=7

# ---------- Phase 2 비전 (기본 꺼짐) ----------
# YOLO names 에 없는 대상만 로컬 Grounding DINO + SAM2. 가중치는 미리 받아 둔다.
# 없거나 torch/transformers 가 없으면 업로드는 YOLO/ONNX/stub 으로 계속된다.
OPEN_VOCAB_ENABLED=false
# --- 지정하지 않은 사람·동물·물체가 대상에 섞여 안 지워지는 문제 (정답 주석 실험으로 고른 값 — docs/vaildates/leak-diagnosis-20261008.md)
# 다른 인스턴스가 차지한 픽셀을 대상에서 덜어내는 규칙: off | subtract(기본) | conf(신뢰도 높은 쪽 소유) | front(앞사람 소유)
MASK_EXCLUSIVE=subtract
# 경계 정제(GrabCut): 켜면 이웃 조각을 끌어와 섞임이 늘고 경계 F 가 낮아졌다 (섞임 6.3→4.6%, 경계 F 0.52→0.61 — 끈 쪽이 낫다). 머리카락 결 선명도가 필요하면 켠다
MASK_GRABCUT=false
# 대비 보정(CLAHE) 입력: 켜면 검출·선택이 나빠졌다 (선택 정확 0.89→0.91 — 끈 쪽이 낫다). 재시도는 반대쪽 입력을 쓴다
PREPROCESS_CLAHE=false
# GrabCut 이 다른 인스턴스 구역을 대상으로 끌어오지 못하게 막는 금지 구역 (GrabCut 을 켤 때만 의미)
# MASK_FORBID_REFINE=false
# 어려운 사례 수집: 처리는 ok 지만 고른 인스턴스의 최소 신뢰도가 이 값 미만이면 (로그인 회원 요청만) 학습 후보로도 저장. 0 = 끔
#   conf_min<0.4 는 사진의 10% 를 골라 그중 31% 가 섞임>5%·오선택 (무작위 13% 의 2.4배). 회원 이미지가 더 저장되므로 기본 꺼짐
HARD_EXAMPLE_CONF=0
# 세그 입력 크기·NMS (0 = 모델 기본 640·0.7). 키우면 오히려 나빠졌다(1280 은 두 사람이 한 덩어리로 합쳐짐 15→29%) — 건드리지 않는 편이 낫다
# SEG_IMGSZ=0
# SEG_NMS_IOU=0
# 프롬프트 해석 체인(LangChain Core): LLM 이 키워드 파서와 대상이 다르게 답하면 최대 PROMPT_VOTES 번 물어 다수결.
# 처음 보는 30문장 대상 정확도 86.7% → 96.7%, LLM 호출 평균 1.4번 (docs/vaildates/leak-diagnosis-20261008.md). legacy = 한 번만
PROMPT_CHAIN=langchain
PROMPT_VOTES=3

# 배경 덩어리(건물·하늘·도로·나무·잔디·물·산·벽·바닥…) — SegFormer(ADE20K) ONNX, onnxruntime 만 필요(Docker 슬림에서도 동작).
# 모델 만들기: python scripts/export_stuff_onnx.py  (기본 b2 110MB · 가벼운 b0 는 --model nvidia/segformer-b0-finetuned-ade-512-512)
# 파일이 없으면 이 기능만 꺼지고 나머지는 그대로다.
STUFF_SEG_ENABLED=true
STUFF_MODEL_PATH=models/segformer-ade.onnx
# STUFF_MIN_PROB=0.5     # 묶음 확률 임계 (낮추면 더 넓게, 높이면 확실한 곳만)
# STUFF_USE_GPU=false    # onnxruntime-gpu 가 있을 때만
# DINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
# SAM2_MODEL_ID=facebook/sam2-hiera-tiny
# DINO 박스·문구 임계값 (YOLO MIN_CONFIDENCE 와 별개). 낮추면 더 많이 잡지만 엉뚱한 영역도 지운다
# OPEN_VOCAB_BOX_THRESHOLD=0.35
# OPEN_VOCAB_TEXT_THRESHOLD=0.25
# 영상은 POST /api/v1/video. 비로그인은 결과만 받고 저장하지 않는다.
VIDEO_MAX_UPLOAD_MB=80
VIDEO_MAX_FRAMES=240
VIDEO_MAX_SECONDS=20
# mp4(H.264+오디오, ffmpeg 필요) | webm(VP8) | avi(MJPG, 다운로드 전용). 못 만들면 mp4 → webm → avi 순으로 자동 전환
VIDEO_OUTPUT_FORMAT=mp4
# 영상 마스크 깜빡임 줄이기: flow(광학 흐름으로 이전 마스크를 옮겨 섞음, 흔들림 −50%) | ema | off
# 비중 = 현재 프레임 몫 (0.5 미만이어야 효과가 있다)
VIDEO_TEMPORAL_SMOOTHING=flow
VIDEO_SMOOTHING_WEIGHT=0.3
# 작업실 GIF 탭: 처리할 최대 프레임 수 (넘으면 앞부분만). 프레임마다 세그를 돌려 시간이 프레임 수에 비례 — 480×360 10프레임 약 4초
GIF_MAX_FRAMES=120
# GIF 한 프레임 픽셀 상한 · 영상 긴 변 상한 (메모리·시간 보호)
GIF_MAX_PIXELS=4000000
VIDEO_MAX_SIDE=3840

# 【수동】 배포 도메인 추가 시 콤마로 나열 (콘솔 5174 포함)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---------- Database (서비스 DB / 학습 DB 분리) ----------
# 서비스 DB : users · auth_* · jobs · batch_jobs          → SQLite (DB_DIALECT)
# 학습 DB   : feedbacks · learning_samples (경로·라벨·검수) → MariaDB (LEARNING_DB_DIALECT)
#   이미지·영상은 DB 에 넣지 않는다 — data/feedback · data/pseudo_labels 파일 경로만 기록
# Docker backend: compose 가 DB_DIALECT=sqlite + LEARNING_DB_DIALECT=mariadb + HOST=mariadb:3306
# 상세: docs/plan/DATABASE.md
DB_DIALECT=sqlite
# backend/ 기준 → backend/data/cutnkeep.host.db (호스트에서 띄운 backend 전용)
# Docker backend·worker 는 compose 가 DOCKER_SQLITE_PATH(기본 data/cutnkeep.db)로 덮는다.
# 두 쪽이 같은 SQLite 파일을 번갈아 쓰면 페이지가 덮여 DB 가 깨진다 — 같은 값으로 맞추지 말 것
SQLITE_PATH=data/cutnkeep.host.db
# DATABASE_URL=  # 있으면 dialect 보다 우선

# 학습 DB — mariadb | sqlite. MARIADB_* 계정을 같이 쓴다
LEARNING_DB_DIALECT=mariadb
# LEARNING_DATABASE_URL=   # 있으면 dialect 보다 우선
# MariaDB 가 꺼져 있으면 backend/data/learning.db 로 대체 (다시 켜고 재기동하면 사이드카에서 동기화)
LEARNING_DB_FALLBACK_SQLITE=true
LEARNING_SQLITE_PATH=data/learning.db
LEARNING_DB_CONNECT_TIMEOUT=3
# 기동 시 data/feedback · data/pseudo_labels 중 DB 에 없는 것 적재 (멱등)
LEARNING_SYNC_ON_START=true
# 로그인 회원의 요청 문장 + 시스템 해석을 검수 후보로 기록 (콘솔 "학습 데이터"에서 승인하면 학습·RAG 에 쓰임)
LEARNING_COLLECT_REQUESTS=true
# 승인된 사용자 문장이 이만큼 새로 쌓이면 LoRA 재학습 (scripts/retrain_lora.py · 콘솔 진행 표시)
LORA_RETRAIN_MIN_NEW=200

# MariaDB — DBeaver/호스트 클라이언트용 (호스트 발행 포트)
#   Host: 127.0.0.1
#   Port: MARIADB_PORT (예: 3309)  ※ 컨테이너 내부 포트는 항상 3306
#   드라이버: MariaDB / 비밀번호만 (GSS·SSL 서버·클라이언트 모두 미사용)
MARIADB_HOST=localhost
MARIADB_PORT=3309
MARIADB_USER=admin
# 【보안】 배포 시 비밀번호 교체. 변경 후 기존 볼륨이면 down -v 후 재생성
MARIADB_PASSWORD=change-me-db-password
MARIADB_DATABASE=cutnkeep
DB_ECHO=false

# MariaDB root (볼륨 최초 생성 시에만 적용)
MYSQL_ROOT_PASSWORD=change-me-root-password

# Frontend / Console (Vite) — 비우면 프록시 사용 가능
# 【수동】 절대 URL 쓸 때만 설정
VITE_API_BASE_URL=http://localhost:8000
# console:5174 · frontend:5173
