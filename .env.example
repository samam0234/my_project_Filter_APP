# =============================================================================
# 【수동】 이 파일을 복사해 `.env` 로 쓰고 값을 채운다 (`.env` 는 git 무시)
# 코드의 Settings(backend/app/core/config.py) 가 아래 키를 읽는다.
#
# Docker: docker compose -p cut_and_keep --env-file .env up -d --build
#   backend 컨테이너는 docker-compose.yml 이 DB/Redis/LLM 접속 주소를 덮어씀
#   호스트 DBeaver: 127.0.0.1 + MARIADB_PORT + MARIADB_USER/PASSWORD
#   Adminer: http://localhost:8081  Server=mariadb
# =============================================================================

# Backend
APP_ENV=development
DEBUG=true
# 【수동·보안】 배포 시 반드시 교체 (비밀번호 재설정 코드 HMAC 키 — 바꾸면 발급된 코드 무효)
SECRET_KEY=change-me-in-production

# ---------- 계정 (로그인 · 회원가입 · 아이디/비밀번호 찾기) ----------
# 상세: docs/guidance/auth.md
SESSION_COOKIE_NAME=cnk_session
SESSION_TTL_HOURS=168
# 【수동·배포】 HTTPS 배포에서는 true (로컬 http 에서 true 면 쿠키가 저장되지 않음)
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_SECONDS=60

# 메일 (아이디 찾기 · 재설정 코드). SMTP_HOST 가 비면 발송 대신 서버 로그에만 기록 (개발용)
# 【수동·배포 필수】 배포에서는 반드시 SMTP 설정
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cut & Keep <no-reply@cutnkeep.local>
SMTP_STARTTLS=true

# File upload limits — 프론트 ImageUploader maxSize 와 동기
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ---------- Paths ----------
# 서비스 런타임 (backend/ 기준 상대 또는 절대)
# 【수동·필수】 서빙할 세그 가중치를 backend/models/ 에 배치 (training/yolo/apply_best.py)
#   파일 없으면 stub 마스크. detect 전용 .pt 넣지 말 것 (masks 필요)
YOLO_MODEL_PATH=models/yolo26s-seg.pt
# YOLO_MODEL_PATH=models/yolo26s-seg.onnx
UPLOAD_DIR=data/uploads
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# 학습 공유 (저장소 루트 기준) — backend 가 기록, training/scripts 가 읽음
FEEDBACK_DIR=data/feedback
PSEUDO_LABEL_DIR=data/pseudo_labels

# ---------- LLM (prompt → JSON) ----------
# 전략: docs/plan/AI_MODEL_STRATEGY.md
# 호출: backend/app/services/prompt_llm.py (nodes.prompt_analyzer 에서 분기)
#   LLM_PROVIDER 에 따라 Ollama/OpenAI/Gemini → 실패·타임아웃 시 휴리스틱 fallback
LLM_PROVIDER=ollama
# ollama | openai | gemini | lora | heuristic
# 초과 시 휴리스틱으로 넘어감 (Ollama 첫 호출은 모델 로드로 느릴 수 있음)
LLM_TIMEOUT_SECONDS=30

# Ollama (local) — ollama pull gemma4:e4b 선행
# 호스트 실행 시 localhost. Docker backend 는 compose 가 host.docker.internal 사용
LLM_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# (선택) Docker 전용 덮어쓰기. 비우면 compose 기본 host.docker.internal:11434
# DOCKER_LLM_BASE_URL=http://host.docker.internal:11434

# LoRA (LLM_PROVIDER=lora) — training/lora 로 학습한 어댑터 서빙 (backend/ 기준 경로)
#   transformers·peft 필요 (requirements.txt 선택 줄). 어댑터는 backend/models/lora/ 에 복사
# LORA_BASE_MODEL=../training/models/qwen2.5-1.5b-instruct
# LORA_ADAPTER_PATH=models/lora

# OpenAI / Gemini (고도화) — 키는 비워 두고 필요할 때만 채움
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- Redis ----------
# 호스트 → compose Redis (호스트 포트 6380 → 컨테이너 6379)
REDIS_URL=redis://localhost:6380/0
# Docker backend: compose 가 redis://redis:6379/0 으로 덮어씀

FILE_RETENTION_HOURS=24

# 【수동】 배포 도메인 추가 시 콤마로 나열 (콘솔 5174 포함)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---------- Database ----------
# 호스트 단독 backend: sqlite 권장
# Docker backend: compose 가 DB_DIALECT=mariadb + HOST=mariadb + PORT=3306
DB_DIALECT=sqlite
# backend/ 기준 → backend/data/cutnkeep.db (서비스 런타임)
SQLITE_PATH=data/cutnkeep.db
# DATABASE_URL=  # 있으면 dialect 보다 우선

# MariaDB — DBeaver/호스트 클라이언트용 (호스트 발행 포트)
#   Host: 127.0.0.1
#   Port: MARIADB_PORT (예: 3309)  ※ 컨테이너 내부 포트는 항상 3306
#   드라이버: MariaDB / 비밀번호만 (GSS·SSL 서버·클라이언트 모두 미사용)
MARIADB_HOST=localhost
MARIADB_PORT=3309
MARIADB_USER=admin
# 【보안】 배포 시 비밀번호 교체. 변경 후 기존 볼륨이면 down -v 후 재생성
MARIADB_PASSWORD=change-me-db-password
MARIADB_DATABASE=cutnkeep
DB_ECHO=false

# MariaDB root (볼륨 최초 생성 시에만 적용)
MYSQL_ROOT_PASSWORD=change-me-root-password

# Frontend / Console (Vite) — 비우면 프록시 사용 가능
# 【수동】 절대 URL 쓸 때만 설정
VITE_API_BASE_URL=http://localhost:8000
# console:5174 · frontend:5173
